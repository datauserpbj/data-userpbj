# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/ahxnszpgszbohssthveb/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend API URL
# Leave empty for local development (Vite proxies /api to backend)
# or when deploying to Vercel (serverless functions handle /api).
# Set to production URL when deploying backend separately (e.g. Railway).
VITE_API_URL=
